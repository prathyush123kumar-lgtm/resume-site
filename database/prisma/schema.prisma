datasource db {
  provider = "sqlite"
  url      = "file:../dev.db"
}

generator client {
  provider = "prisma-client-js"
  output   = "../../backend/node_modules/.prisma/client"
}

model Project {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  techStack   String
  githubUrl   String?
  liveUrl     String?
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
