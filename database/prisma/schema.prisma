// This is your Prisma schema file.
// Learn more about it at https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── Projects ──────────────────────────────────────────────
model Project {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  description     String
  shortDescription String
  imageUrl        String   @default("")
  // techStack is stored as a JSON string e.g. '["Python","Flask"]'
  techStack       String
  category        String   @default("web")       // "web" | "python" | "tools"
  status          String   @default("completed")  // "completed" | "in-progress"
  githubUrl       String?
  liveUrl         String?
  featured        Boolean  @default(false)
  sortOrder       Int      @default(0)
  highlights      String   @default("[]")         // JSON array of bullet strings
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── Contact Messages ──────────────────────────────────────
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  ipAddress String?
  userAgent String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
