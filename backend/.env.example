# ═══════════════════════════════════════════
# Server Configuration
# ═══════════════════════════════════════════
PORT=4000
NODE_ENV=development

# ═══════════════════════════════════════════
# Database
# ═══════════════════════════════════════════
DATABASE_URL="file:../database/dev.db"

# ═══════════════════════════════════════════
# Security
# ═══════════════════════════════════════════
# Replace with your actual frontend URL when deployed
FRONTEND_ORIGIN=http://localhost:3000

# Cloudflare Turnstile (get from https://dash.cloudflare.com → Turnstile)
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key-here

# ═══════════════════════════════════════════
# Email (optional — for contact notifications)
# ═══════════════════════════════════════════
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=prathyush123kumar@gmail.com
SMTP_PASS=your-gmail-app-password-here
NOTIFICATION_EMAIL=prathyush123kumar@gmail.com
